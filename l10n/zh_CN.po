msgstr "尚未加入任何 NeoDB 书架"

msgid "Not signed in"
msgstr "未登录"

msgid "Not this book"
msgstr "本书不用"

msgid "Note on “%1”"
msgstr "《%1》的笔记"

msgid "Note posted to NeoDB."
msgstr "笔记已发布到 NeoDB。"

msgid "Note title"
msgstr "笔记标题"

msgid "Nothing on NeoDB matched “%1”."
msgstr "NeoDB 上没有与“%1”匹配的结果。"

msgid "Nothing there to post to NeoDB."
msgstr "没有可发布到 NeoDB 的内容。"

msgid "Nothing waiting to upload."
msgstr "没有待上传内容。"

msgid "On NeoDB: %1"
msgstr "NeoDB 状态：%1"

msgid "On “%1”"
msgstr "关于《%1》"

msgid "Open the authorization page on your phone or computer, sign in, and approve access.\n\nNeoDB will then show you a short code. Come back here and tap \"I have the code\"."
msgstr "请在手机或电脑上打开授权页面，登录并允许访问。\n\nNeoDB 随后会显示一个简短的验证码。请返回此处点击“我已获得验证码”。"

msgid "Other instance…"
msgstr "其他实例…"

msgid "Page number"
msgstr "页码"

msgid "Page numbers for fixed-layout files and for EPUBs with publisher page numbers; percentage otherwise, since reflowed page numbers differ on every device."
msgstr "固定版式文件及带出版页码的 EPUB 使用页码；其他文件使用百分比，因为重排版后的页码会因设备而异。"

msgid "Pairing service"
msgstr "配对服务"

msgid "Pairing service: %1"
msgstr "配对服务：%1"

msgid "Paste a NeoDB book link, or a link from a site NeoDB can import from."
msgstr "粘贴 NeoDB 书籍链接，或 NeoDB 支持导入的网站链接。"

msgid "Paused: NeoDB asked us to slow down. Try again in a minute."
msgstr "已暂停：NeoDB 要求降低请求频率。请稍后重试。"

msgid "Paused: NeoDB did not accept your login. Sign in again to send these."
msgstr "已暂停：NeoDB 未接受你的登录信息。请重新登录后上传。"

msgid "Paused: the NeoDB server could not be reached."
