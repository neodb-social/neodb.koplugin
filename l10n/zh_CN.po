msgid "NeoDB did not accept your login. Please sign in again."
msgstr "NeoDB 未接受你的登录信息，请重新登录。"

msgid "NeoDB for KOReader\n\nVersion: %1\nInstance: %2\nAccount: %3\n\nMarks, notes and progresses are saved to your NeoDB account. Anything made while offline is queued and uploaded next time you are online."
msgstr "KOReader 的 NeoDB 插件\n\n版本：%1\n实例：%2\n账号：%3\n\n标记、笔记和阅读进度会保存到你的 NeoDB 账号。离线操作会加入队列，并在下次联网时上传。"

msgid "NeoDB instance"
msgstr "NeoDB 实例"

msgid "NeoDB is a free open-sourced software and a distributed community, somewhat similar to Goodreads, but instead of being a single commercial service holding everyone's data, NeoDB is a network of self-hosted servers that interconnected via open protocols like ActivityPub and ATProto. You may use NeoDB to share your reading journey with friends on Mastodon and Bluesky, or use it purely for private reading log, as NeoDB's privacy setup supports both.\n\nLearn more at %1"
msgstr "NeoDB 是一个免费的开源软件和分布式社区，类似于 Goodreads。但它并非由单一商业服务保管所有人的数据，而是由自行托管的服务器组成，通过 ActivityPub、ATProto 等开放协议互相连接。你可以在 NeoDB 上与 Mastodon 和 Bluesky 的朋友分享阅读历程，也可以只用它记录私人的阅读日志，两种用途都有相应的隐私设置。\n\n了解更多：%1"

msgid "NeoDB is rate-limiting us. Please try again in a minute."
msgstr "NeoDB 限制了请求频率，请稍后重试。"

msgid "NeoDB is still importing that page. Try again in a moment."
msgstr "NeoDB 仍在导入该页面，请稍后重试。"

msgid "NeoDB rating: %1 (%2 ratings)"
msgstr "NeoDB 评分：%1（%2 人评分）"

msgid "NeoDB refused this request. Your token may lack write access."
msgstr "NeoDB 拒绝了此请求。你的访问令牌可能缺少写入权限。"

msgid "NeoDB request failed (HTTP %d)."
msgstr "NeoDB 请求失败（HTTP %d）。"

msgid "NeoDB request failed."
msgstr "NeoDB 请求失败。"

msgid "NeoDB uploads are paused: sign in again to send them."
msgstr "NeoDB 上传已暂停：请重新登录后发送。"

msgid "NeoDB: %1 result(s)"
msgstr "NeoDB：%1 条结果"

msgid "NeoDB: add note"
msgstr "NeoDB：添加笔记"

msgid "NeoDB: book actions"
msgstr "NeoDB：本书操作"

msgid "NeoDB: post something"
msgstr "NeoDB：发布动态"

msgid "NeoDB: update reading progress"
msgstr "NeoDB：更新阅读进度"

msgid "No NeoDB instance configured."
msgstr "尚未配置 NeoDB 实例。"

msgid "No network connection."
msgstr "没有网络连接。"

msgid "No pairing service is configured."
msgstr "尚未配置配对服务。"

msgid "No rating"
msgstr "未评分"

msgid "No token file found.\n\nCreate an access token at %1/developer/, save it as a text file named %2, and copy it to either of these locations:\n\n%3\n\nThen try again."
msgstr "未找到令牌文件。\n\n请在 %1/developer/ 创建访问令牌，将其保存为名为 %2 的文本文件，并复制到以下任一位置：\n\n%3\n\n然后重试。"

msgid "None of those books are linked to NeoDB."
msgstr "这些书籍都尚未关联到 NeoDB。"

