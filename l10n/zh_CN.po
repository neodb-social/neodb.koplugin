msgstr "开发测试站，英语"

msgid "en"
msgstr "英语"

msgid "flagship, zh/en"
msgstr "主站，中英双语"

msgid "not set"
msgstr "未设置"

msgid "not signed in"
msgstr "未登录"

msgid "off"
msgstr "关闭"

msgid "on"
msgstr "开启"

msgid "page %1"
msgstr "第 %1 页"

msgid "page %1 of %2"
msgstr "第 %1 页，共 %2 页"

msgid "page number"
msgstr "页码"

msgid "percentage"
msgstr "百分比"

msgid "queued %1 highlight(s)"
msgstr "%1 条高亮已加入队列"

